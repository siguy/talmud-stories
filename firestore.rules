rules_version = '2';

// Firestore access rules for the Septimus sign-up.
// The weekly script uses the Admin SDK, which bypasses these rules entirely.
// So these rules only govern what a person's browser may do: signed in, or (two narrow cases, marked
// "EMAIL LINK" below) signed out but holding the private code from that person's own weekly email.
// Anything not matched below is denied.
// Tested in the local emulator: tests/test_firestore_rules.py

service cloud.firestore {
  match /databases/{database}/documents {

    // One record per person. Only that person may read it. Nobody can list
    // everyone's records, and nobody can delete (the script does deletions).
    match /users/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;

      // Joining: exactly these four fields, with the server's clock for
      // createdAt, 1-120 minutes, a short lowercase "src", not pending delete.
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(
             ['createdAt', 'minutesPerWeek', 'src', 'deleteRequested'])
        && request.resource.data.createdAt == request.time
        && request.resource.data.minutesPerWeek is int
        && request.resource.data.minutesPerWeek >= 1
        && request.resource.data.minutesPerWeek <= 120
        && request.resource.data.src is string
        && request.resource.data.src.matches('^[a-z0-9-]{0,32}$')
        && request.resource.data.deleteRequested == false;

      // Changing settings: only minutesPerWeek (0 = stop) and deleteRequested,
      // plus pausedAt, but only to clear it (resume after a pause): a person
      // can never SET pausedAt. createdAt, src, lastLearnedWeek, lapses and mailToken (the
      // script's own bookkeeping) can never be changed by the person.
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['minutesPerWeek', 'deleteRequested', 'pausedAt'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['pausedAt'])
            || request.resource.data.pausedAt == null)
        && request.resource.data.minutesPerWeek is int
        && request.resource.data.minutesPerWeek >= 0
        && request.resource.data.minutesPerWeek <= 120
        && request.resource.data.deleteRequested is bool;

      // EMAIL LINK: unsubscribe (or undo it) without signing in. Every weekly email carries the person's
      // private code (mailToken, written only by the script). Whoever holds that code may switch emailOff
      // on or off, and nothing else. The code used is written alongside (mailTokenUsed) because a rule can
      // only check what is being written. A person with no code yet cannot be touched this way.
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['emailOff', 'mailTokenUsed'])
        && resource.data.mailToken is string
        && resource.data.mailToken.size() >= 20
        && request.resource.data.mailTokenUsed == resource.data.mailToken
        && request.resource.data.emailOff is bool;
    }

    // One row per person per hand-out story. A person can read only their own
    // rows (a list query must filter on their own uid) and may only tick a
    // story done (server time) or untick it (null). Only the script creates
    // or deletes rows.
    match /assignments/{id} {
      allow get, list: if request.auth != null
        && resource.data.uid == request.auth.uid;

      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['doneAt'])
        && (request.resource.data.doneAt == request.time
            || request.resource.data.doneAt == null);

      // EMAIL LINK: "Mark as learned" without signing in. Whoever holds the private code of the person the
      // row belongs to may tick it (server time), once. Never untick, never anything else, and never a row
      // whose person has been deleted (its uid is empty, so there is no record to hold a code).
      allow update: if resource.data.uid is string
        && resource.data.uid != ''
        && resource.data.doneAt == null
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['doneAt', 'mailTokenUsed'])
        && request.resource.data.doneAt == request.time
        && get(/databases/$(database)/documents/users/$(resource.data.uid)).data.mailToken is string
        && get(/databases/$(database)/documents/users/$(resource.data.uid)).data.mailToken.size() >= 20
        && request.resource.data.mailTokenUsed
             == get(/databases/$(database)/documents/users/$(resource.data.uid)).data.mailToken;
    }

    // The public community counts. Anyone, even signed out, may read.
    // Only the script writes.
    match /progress/summary {
      allow get: if true;
    }

    // runs/*, sent/*, and everything else: no client access (default deny).
  }
}
