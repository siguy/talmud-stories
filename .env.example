# Copy to .env and fill in. .env is gitignored; this file is the shared record of
# which settings exist and what they should be.

GOOGLE_API_KEY=your-key-here          # https://aistudio.google.com/app/apikey

# Model and reasoning effort. Both have defaults in src/model_config.py, so a run
# without them still works -- these exist so a run's configuration is explicit.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_THINKING_LEVEL=high            # low | medium | high

# NOTE ON COST, measured 2026-09-03 on gemini-3.8-flash:
# at thinking_level=high a single detection call spent 7,867 thinking tokens against
# 321 tokens of actual output, and took 14-70s per page. Thinking tokens are billed as
# output. Set this to low for cheap screens; keep high for detection runs where the
# judgement matters.
