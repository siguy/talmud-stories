#!/bin/sh
# scripts/evaluate_golden.py is IMMUTABLE (CLAUDE.md). Every score in this repo is
# comparable only because it has not moved. Three lines, so it costs nothing on every
# commit; tests/test_bookkeeping.py pins the same hash for anyone who skips hooks.
PINNED=5b83879e731b361d312bc72b3faa2598eaae585b
ACTUAL=$(git hash-object scripts/evaluate_golden.py 2>/dev/null)
[ "$ACTUAL" = "$PINNED" ] || { echo "pre-commit: scripts/evaluate_golden.py CHANGED ($ACTUAL != $PINNED)."; echo "  If deliberate, update PINNED here and EVALUATE_GOLDEN_SHA in tests/test_bookkeeping.py, and say why."; exit 1; }

# The harness writes here when --output is omitted. The baseline it would overwrite is
# from a run that cannot be reproduced, so the overwrite is unrecoverable.
BASE_PINNED=e5e46fd7ac174b2a52c4030ed71bb603c2f79067
BASE_ACTUAL=$(git hash-object docs/golden/v7/baseline_ketubot.json 2>/dev/null)
[ "$BASE_ACTUAL" = "$BASE_PINNED" ] || { echo "pre-commit: docs/golden/v7/baseline_ketubot.json CHANGED."; echo "  Almost certainly evaluate_golden.py run without --output. Restore it:"; echo "    git checkout -- docs/golden/v7/baseline_ketubot.json"; exit 1; }

# Every src/story_detector_v*.py main() writes here unconditionally (no --output). It is
# the frozen v7 baseline three test files score against. Nothing reaches the write today
# only because those main()s crash first on a stale input path -- an accident, not a guard.
V7RES_PINNED=e50afc966bbe74f875e7cb572659b66d2bd6c68e
V7RES_ACTUAL=$(git hash-object results/v7/ketubot_v7_2-60.json 2>/dev/null)
[ "$V7RES_ACTUAL" = "$V7RES_PINNED" ] || { echo "pre-commit: results/v7/ketubot_v7_2-60.json CHANGED."; echo "  Almost certainly a detector run directly (python3 src/story_detector_vN.py). Restore it:"; echo "    git checkout -- results/v7/ketubot_v7_2-60.json"; exit 1; }
